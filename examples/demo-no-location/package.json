{
  "name": "demo-no-location",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "ONESIGNAL_DISABLE_LOCATION=true bash ../run-android.sh",
    "build": "vp build",
    "clean:android": "rm -rf android/app/build android/app/.cxx android/build",
    "clean:ios": "rm -rf ios/App/build ios/DerivedData ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm",
    "dev": "vp dev --host --port 5173",
    "ios": "ONESIGNAL_DISABLE_LOCATION=true bash ../run-ios.sh",
    "preandroid": "bun run setup",
    "preios": "bun run setup",
    "setup": "ONESIGNAL_DISABLE_LOCATION=true bash ./setup.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@onesignal/capacitor-plugin": "file:../../onesignal-capacitor-plugin.tgz",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.13"
}
