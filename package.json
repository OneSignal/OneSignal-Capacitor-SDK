{
  "version": "1.0.0",
  "name": "onesignal-capacitor-plugin",
  "files": [
    "dist",
    "ios",
    "android",
    "Package.swift",
    "OneSignalCapacitorPlugin.podspec"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneSignal/OneSignal-Capacitor-SDK.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "vp build && vitest run && vp lint",
    "docgen": "docgen --api OneSignalCapacitorPlugin --output-readme README.md --output-json dist/docs.json"
  },
  "peerDependencies": {
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/docgen": "^0.2.2",
    "@types/bun": "latest",
    "happy-dom": "^20.0.8",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "0.1.15"

  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "bugs": {
    "url": "https://github.com/OneSignal/OneSignal-Capacitor-SDK/issues"
  },
  "description": "OneSignal is a high volume Push Notification service for mobile apps. This is the pure Capacitor plugin for OneSignal, providing push notifications, in-app messaging, and more.",
  "homepage": "https://github.com/OneSignal/OneSignal-Capacitor-SDK#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "push",
    "notification",
    "push notification",
    "push notifications",
    "apns",
    "fcm",
    "onesignal"
  ],
  "license": "MIT",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.11"
}